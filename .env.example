# Kopiera till .env och fyll i dina egna värden (ecowitt.net -> kontoikon ->
# User Profile / Private Center -> API Keys). Ladda och exportera värden
# före körning: set -a; source .env; set +a
ECOWITT_APPLICATION_KEY=din_application_key
ECOWITT_API_KEY=din_api_key
# WS90-stationens MAC (även använd av äldre enstationsskript)
ECOWITT_MAC=AA:BB:CC:DD:EE:FF
# G3000-stationens MAC
ECOWITT_G3000_MAC=AA:BB:CC:DD:EE:FF

# Valfria separata callback-grupper om stationerna har olika sensorer.
# Standardvärdet för båda är:
# outdoor,indoor,solar_and_uvi,rainfall_piezo,wind,pressure
# ECOWITT_WS90_CALL_BACK=outdoor,indoor,solar_and_uvi,rainfall_piezo,wind,pressure
# ECOWITT_G3000_CALL_BACK=outdoor,indoor,solar_and_uvi,rainfall_piezo,wind,pressure
