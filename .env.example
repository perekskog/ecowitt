# Kopiera till .env och fyll i dina egna värden (ecowitt.net -> kontoikon ->
# User Profile / Private Center -> API Keys). Ladda och exportera värden
# före körning: set -a; source .env; set +a
ECOWITT_APPLICATION_KEY=din_application_key
ECOWITT_API_KEY=din_api_key
# MAC-adresser för respektive Ecowitt-enhet
ECOWITT_EASYWEATHERPRO_4F447C_MAC=AA:BB:CC:DD:EE:FF
ECOWITT_GW3000A_WIFI1573_MAC=AA:BB:CC:DD:EE:FF

# Valfria separata callback-grupper om stationerna har olika sensorer.
# Standardvärdet för båda är:
# outdoor,indoor,solar_and_uvi,rainfall_piezo,wind,pressure
# Gäller EasyWeatherPro-4F447C respektive GW3000A-WIFI1573:
# ECOWITT_EASYWEATHERPRO_4F447C_CALL_BACK=outdoor,indoor,solar_and_uvi,rainfall_piezo,wind,pressure
# ECOWITT_GW3000A_WIFI1573_CALL_BACK=outdoor,indoor,solar_and_uvi,rainfall_piezo,wind,pressure

# För äldre enstationsskript används fortfarande ECOWITT_MAC.
# ECOWITT_MAC=AA:BB:CC:DD:EE:FF
